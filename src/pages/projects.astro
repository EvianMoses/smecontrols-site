---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import Gallery from '../components/Gallery.astro';
import { projects } from '../data/site';
---
<Base
  title='פרויקטים | ששון משה הנדסת חשמל בע"מ'
  description='מהפרויקטים שלנו: מערכות חשמל, פיקוד ובקרה למפעלי מצות, תחנות קמח, מחצבות, מקוואות ופסי ייצור בישראל ובעולם.'
>
  <section class="page-head">
    <div class="container">
      <h1>פרויקטים</h1>
      <p>חברתנו הובילה כמה מהפרויקטים הגדולים בישראל בתחום החשמל, הפיקוד והבקרה. מוזמנים לקרוא ולהתרשם.</p>
    </div>
  </section>

  {projects.map((p, i) => (
    <section class={`section ${i % 2 ? 'soft' : ''}`} aria-labelledby={`p-${i}`}>
      <div class="container">
        <h2 id={`p-${i}`}><span class="num">{String(i + 1).padStart(2, '0')}</span> {p.title}</h2>
        {p.paragraphs.map((t) => <p>{t}</p>)}
        {p.images.length > 0 && (
          <div class="pg"><Gallery images={p.images} alt={`תמונה מפרויקט ${p.title}`} /></div>
        )}
      </div>
    </section>
  ))}

  <Contact />
</Base>

<style>
  .page-head { background: var(--navy); color: #fff; padding: 56px 0; }
  .page-head h1 { color: #fff; margin: 0 0 8px; font-size: clamp(2rem, 4vw, 2.8rem); }
  .num { color: var(--accent-dark); font-weight: 800; margin-inline-end: 6px; }
  .section p { max-width: 820px; }
  .pg { margin-top: 20px; }
</style>
