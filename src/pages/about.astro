---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import PartnerLogos from '../components/PartnerLogos.astro';
import { business, partners } from '../data/site';

const services = [
  {
    title: 'ייעוץ ותכנון הנדסי',
    text: 'אפיון צורכי המפעל, תכנון מערכות חשמל, כוח, פיקוד ובקרה, והכנת תוכניות עבודה מפורטות לפני שמתחילים לבנות.',
  },
  {
    title: 'ייצור לוחות חשמל ופיקוד',
    text: 'בניית לוחות חשמל ולוחות בקרה במפעל שלנו, בחיווט מסודר וברמת גימור גבוהה, תחת הסמכת מכון התקנים הישראלי.',
  },
  {
    title: 'מערכות בקרה ואוטומציה',
    text: 'תכנות בקרים, מסכי מגע ותוכנות ייעודיות שנכתבות במיוחד לכל לקוח, כך שפס ייצור שלם יכול להיות מופעל על ידי אדם אחד.',
  },
  {
    title: 'אינטגרציה וקליטת מכונות מחו"ל',
    text: 'ליווי ביבוא מכונות וציוד מאירופה ומהעולם, והתאמתם לתקנים, לרשת החשמל ולמערכות הקיימות במפעל בישראל.',
  },
  {
    title: 'חידוש ושדרוג מערכות קיימות',
    text: 'החלפת מערכות ישנות ומסורבלות במערכות בקרה מודרניות, שמוסיפות חיישנים, ניטור תקלות ושליטה מלאה, וחוסכות כוח אדם.',
  },
  {
    title: 'ביצוע בשטח ושירות',
    text: 'התקנה, הפעלה והרצה באתר הלקוח, ולאחר מכן שירות, תחזוקה ופתרון תקלות מהיר על ידי הצוות שבנה את המערכת.',
  },
];

const industries = [
  'מפעלי מזון ומאפיות, כולל פסי ייצור מצות כשרות למהדרין',
  'תחנות קמח ומערכות שינוע וטחינה',
  'מחצבות, מגרסות ומפעלי בטון',
  'מקוואות, עם מערכות מים, חימום ושעוני שבת',
  'תחנות שאיבה וסניקה',
  'מפעלי מתכת ועיבוד פח',
];

const steps = [
  { title: 'שיחת היכרות ואפיון', text: 'מגיעים לשטח, מקשיבים ומבינים מה המפעל צריך באמת.' },
  { title: 'תכנון והצעה', text: 'תכנון מפורט והצעת מחיר ברורה, בלי הפתעות בהמשך הדרך.' },
  { title: 'ייצור ובדיקות', text: 'בניית הלוחות והמערכות אצלנו, ובדיקה של כל רכיב לפני היציאה לשטח.' },
  { title: 'התקנה והרצה', text: 'התקנה באתר, הרצה מלאה והדרכה לצוות המפעיל.' },
  { title: 'ליווי ושירות', text: 'אנחנו נשארים זמינים גם אחרי המסירה, לשירות, לשדרוגים ולתקלות.' },
];
---
<Base
  title='אודות | ששון משה הנדסת חשמל בע"מ'
  description='ששון משה הנדסת חשמל: קרוב ל-30 שנות ניסיון בתכנון, ייצור והקמה של מערכות חשמל, פיקוד ובקרה לתעשייה בישראל ובעולם.'
>
  <section class="page-head">
    <div class="container">
      <h1>אודות</h1>
      <p>מעטפת הנדסית שלמה לחשמל, פיקוד ובקרה, מהרעיון הראשון ועד מערכת שעובדת.</p>
    </div>
  </section>

  <section class="section">
    <div class="container intro">
      <div>
        <h2>מי אנחנו</h2>
        <p>
          {business.name} מתכננת, מייצרת ומקימה מערכות חשמל, פיקוד ובקרה לתעשייה כבר קרוב ל-30 שנה.
          אנחנו עובדים עם מפעלים, מוסדות ורשויות בכל רחבי הארץ ובחו"ל, והקמנו פסי ייצור שלמים בתחומי המזון, הקמח, הבטון, המים ועוד.
        </p>
        <p>
          אנחנו מאמינים שמערכת בקרה טובה צריכה להיות אמינה, בטוחה ופשוטה להפעלה.
          לכן אנחנו מלווים כל פרויקט בעצמנו, מהשלב שבו הוא עוד רעיון על דף ועד שהמערכת רצה בשטח, ונשארים זמינים גם אחרי המסירה.
        </p>
        <p>
          המפעל שלנו נמצא ב{business.address}, ושם נבנים ונבדקים הלוחות והמערכות לפני שהם יוצאים ללקוח.
        </p>
      </div>
      <img src="/images/p04-flour-2.jpg" alt="כבלים ולוחות בקרה בתחנת קמח שהקמנו" loading="lazy" />
    </div>
  </section>

  <section class="section soft" aria-labelledby="values-title">
    <div class="container">
      <h2 id="values-title">מה מבדיל אותנו</h2>
      <div class="values">
        <article>
          <h3>יסודיות בכל פרט</h3>
          <p>אנחנו בודקים כל פרט, מהשרטוט הראשון ועד החיווט האחרון, ולא מוסרים מערכת עד שהיא עובדת בדיוק כמו שצריך.</p>
        </article>
        <article>
          <h3>אמינות ללא פשרות</h3>
          <p>מה שסיכמנו הוא מה שתקבלו: עמידה בלוחות זמנים, שקיפות מלאה ומחיר ברור מראש.</p>
        </article>
        <article>
          <h3>ליווי אישי וצמוד</h3>
          <p>כל לקוח מקבל יחס אישי וזמינות מלאה לאורך כל הפרויקט, ומי שבנה את המערכת הוא גם מי שנותן לה שירות.</p>
        </article>
        <article>
          <h3>בטיחות ותקינה</h3>
          <p>עבודה לפי התקנים המחמירים ביותר, תחת הסמכת מכון התקנים הישראלי.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="services-title">
    <div class="container">
      <h2 id="services-title">מה אנחנו עושים</h2>
      <div class="services">
        {services.map((s) => (
          <article>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section soft" aria-labelledby="industries-title">
    <div class="container two">
      <div>
        <h2 id="industries-title">תחומים שבהם אנחנו עובדים</h2>
        <ul class="industries">
          {industries.map((i) => <li>{i}</li>)}
        </ul>
        <a class="btn btn-outline" href="/projects">לפרויקטים שלנו</a>
      </div>
      <div>
        <h2>איך זה עובד</h2>
        <ol class="steps">
          {steps.map((s) => (
            <li>
              <strong>{s.title}</strong>
              <span>{s.text}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="brands-title">
    <div class="container">
      <h2 id="brands-title">עובדים עם המותגים המובילים</h2>
      <PartnerLogos logos={partners} />
    </div>
  </section>

  <Contact />
</Base>

<style>
  .page-head { background: var(--navy); color: #fff; padding: 56px 0; }
  .page-head h1 { color: #fff; margin: 0 0 8px; font-size: clamp(2rem, 4vw, 2.8rem); }
  .intro { display: grid; grid-template-columns: 3fr 2fr; gap: 40px; align-items: center; }
  .intro img { border-radius: var(--radius); }
  .values, .services { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
  .values article, .services article {
    background: #fff; border-radius: var(--radius); padding: 24px;
    border-top: 4px solid var(--accent); box-shadow: 0 4px 18px rgba(15, 42, 68, 0.06);
  }
  .services { grid-template-columns: repeat(3, 1fr); }
  .services article { border-top-color: var(--navy-2); }
  article h3 { margin: 0 0 8px; font-size: 1.2rem; }
  article p { margin: 0; color: var(--muted); }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .industries { padding-inline-start: 20px; margin-bottom: 24px; }
  .industries li { margin-bottom: 6px; }
  .steps { list-style: none; padding: 0; margin: 0; counter-reset: step; }
  .steps li {
    counter-increment: step; position: relative; padding-inline-start: 52px; margin-bottom: 18px;
    display: grid; gap: 2px;
  }
  .steps li::before {
    content: counter(step); position: absolute; inset-inline-start: 0; top: 0;
    width: 36px; height: 36px; border-radius: 50%; background: var(--accent); color: #1a1300;
    display: grid; place-items: center; font-weight: 800;
  }
  .steps span { color: var(--muted); }
  @media (max-width: 760px) {
    .intro, .two, .services { grid-template-columns: 1fr; }
  }
</style>
