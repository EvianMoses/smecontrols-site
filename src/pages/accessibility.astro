---
import Base from '../layouts/Base.astro';
import { business } from '../data/site';

// Update this date whenever the site or this statement changes.
const updated = '2.11.2026';
const coordinator = {
  name: 'אביעד דוד משה',
  phone: '02-6527369',
  phoneIntl: '+97226527369',
  email: 'aviadavid31@gmail.com',
};
---
<Base
  title='הצהרת נגישות | ששון משה הנדסת חשמל בע"מ'
  description='הצהרת הנגישות של אתר ששון משה הנדסת חשמל בע"מ ודרכי פנייה לרכז הנגישות.'
>
  <section class="section">
    <div class="container text">
      <h1>הצהרת נגישות</h1>
      <p><strong>הצהרת הנגישות עודכנה בתאריך {updated}.</strong></p>
      <p>
        אנחנו, {business.name}, פועלים להנגשת אתר האינטרנט שלנו <a href="https://www.smecontrols.com/">smecontrols.com</a> לאנשים עם מוגבלות,
        מתוך אמונה שלכל אדם מגיעה הזכות לגלוש באתר בשוויון, בכבוד, בעצמאות ובנוחות.
      </p>

      <h2>מהו אתר אינטרנט נגיש</h2>
      <p>
        אתר אינטרנט נגיש הוא אתר המאפשר לאדם עם מוגבלות לגלוש באותה רמת יעילות והנאה כמו גולשים אחרים,
        תוך שימוש ביכולות המערכת שעליה הוא פועל ובאמצעות טכנולוגיות מסייעות לנגישות.
      </p>

      <h2>רמת הנגישות באתר</h2>
      <p>
        האתר הותאם בהתאם לתקנה 35 בתקנות שוויון זכויות לאנשים עם מוגבלות (התאמות נגישות לשירות), התשע"ג-2013,
        ולתקן הישראלי ת"י 5568, המבוסס על הנחיות WCAG 2.0 של ארגון W3C, ברמה AA.
        האתר נבנה מחדש בשנת 2026 תוך הקפדה גם על ההנחיות המעודכנות של WCAG 2.1 ברמה AA.
      </p>

      <h2>ההתאמות שבוצעו באתר</h2>
      <ul>
        <li>שפת האתר וכיוון הקריאה (מימין לשמאל) מוגדרים בקוד, כך שקוראי מסך מקריאים את התוכן נכון.</li>
        <li>מבנה כותרות ברור והיררכי וסימון סמנטי של אזורי הדף (כותרת עליונה, תפריט, תוכן ראשי ותחתית).</li>
        <li>אפשרות לנווט באתר כולו באמצעות המקלדת בלבד, עם סימון בולט של הרכיב שבפוקוס.</li>
        <li>קישור "דילוג לתוכן הראשי" בתחילת כל עמוד.</li>
        <li>טקסט חלופי לתמונות בעלות משמעות.</li>
        <li>שילובי צבעים העומדים ביחס הניגודיות הנדרש.</li>
        <li>טופס יצירת הקשר כולל תוויות ברורות לכל שדה והודעות מצב שקוראי מסך מקריאים.</li>
        <li>האתר מותאם לתצוגה בטלפונים ובמסכים בגדלים שונים ותומך בהגדלת טקסט עד 200% בלי לאבד תוכן.</li>
        <li>אין באתר תוכן מהבהב, ואנימציות הגלילה מבוטלות אצל מי שהגדיר במכשירו העדפה לצמצום תנועה.</li>
        <li>האתר נבדק בדפדפנים הנפוצים: כרום, פיירפוקס, אדג' וספארי.</li>
      </ul>

      <h2>מגבלות ידועות</h2>
      <p>
        אנו עושים מאמצים כדי שכל דפי האתר יהיו נגישים. עם זאת, ייתכן שיתגלו חלקים שטרם הונגשו במלואם,
        למשל לוגואים של לקוחות ושותפים שמקורם בגורמים חיצוניים. אם נתקלתם בבעיה, נשמח שתעדכנו אותנו ונפעל לתקן אותה.
      </p>

      <h2>נגישות המשרדים</h2>
      <p>
        משרדי החברה נמצאים בכתובת {business.address}. לפרטים על הסדרי הנגישות הפיזיים במקום
        ולתיאום הגעה, אפשר לפנות לרכז הנגישות.
      </p>

      <h2>דרכי פנייה לבקשות, תקלות נגישות והצעות לשיפור</h2>
      <p>
        אם מצאתם באתר בעיה בנושא הנגישות או שאתם זקוקים לעזרה, אתם מוזמנים לפנות אלינו דרך רכז הנגישות של החברה.
        כדי שנוכל לטפל בפנייה בצורה הטובה ביותר, נשמח לקבל תיאור של הבעיה, באיזה עמוד היא נמצאה, ואת סוג הדפדפן וטכנולוגיה המסייעת שבה השתמשתם.
      </p>
      <ul class="contact">
        <li><strong>רכז הנגישות:</strong> {coordinator.name}</li>
        <li><strong>טלפון:</strong> <a href={`tel:${coordinator.phoneIntl}`} dir="ltr">{coordinator.phone}</a></li>
        <li><strong>מייל:</strong> <a href={`mailto:${coordinator.email}`}>{coordinator.email}</a></li>
        <li><strong>כתובת:</strong> {business.address}</li>
      </ul>
      <p>נשתדל להשיב לכל פנייה בתוך זמן סביר.</p>
    </div>
  </section>
</Base>

<style>
  .text { max-width: 860px; }
  .text h1 { font-size: clamp(2rem, 4vw, 2.6rem); }
  .text h2 { font-size: 1.4rem; margin: 32px 0 8px; }
  .text li { margin-bottom: 6px; }
  .contact { list-style: none; padding: 0; }
</style>
