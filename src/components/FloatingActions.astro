---
import { business } from '../data/site';
const waText = encodeURIComponent('שלום, הגעתי מהאתר ואשמח לפרטים');
const waUrl = business.whatsapp ? `https://wa.me/${business.whatsapp}?text=${waText}` : '';
---
<div class="floating" aria-label="יצירת קשר מהירה">
  <a class="fab call" href={`tel:${business.phoneIntl}`}>📞 התקשרו עכשיו</a>
  {waUrl && <a class="fab wa" href={waUrl} target="_blank" rel="noopener">וואטסאפ</a>}
</div>
{waUrl && (
  <a class="wa-desktop" href={waUrl} target="_blank" rel="noopener" aria-label="שליחת הודעה בוואטסאפ">
    <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm0 23.6c-2 0-3.9-.5-5.6-1.5l-.4-.2-3.9 1 1-3.8-.3-.4A10.6 10.6 0 1 1 16 26.6zm5.8-7.9c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1a8.7 8.7 0 0 1-4.3-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.9.4 3.7 3.7 0 0 0-1.1 2.7 6.5 6.5 0 0 0 1.4 3.4 14.6 14.6 0 0 0 5.6 5c2.1.9 2.9 1 4 .8a3.4 3.4 0 0 0 2.2-1.6 2.8 2.8 0 0 0 .2-1.6c-.1-.1-.3-.2-.6-.4z"/></svg>
  </a>
)}

<style>
  .floating { display: none; }
  .wa-desktop {
    position: fixed; bottom: 24px; left: 24px; z-index: 60; width: 58px; height: 58px;
    border-radius: 50%; background: #1f9e4f; color: #fff; display: grid; place-items: center;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25); transition: transform 0.2s ease;
  }
  .wa-desktop:hover { transform: scale(1.08); }
  @media (max-width: 760px) {
    .wa-desktop { display: none; }
    .floating {
      display: flex; gap: 8px; position: fixed; bottom: 12px; left: 12px; right: 12px; z-index: 60;
    }
    .fab {
      flex: 1; text-align: center; padding: 14px; border-radius: 999px; font-weight: 700;
      text-decoration: none; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    }
    .call { background: var(--accent); color: #1a1300; }
    .wa { background: #1f9e4f; color: #fff; }
  }
</style>
