---
// Photo grid with hover zoom; clicking a photo opens a full-screen viewer
// with next/previous (buttons, arrow keys, swipe) and Esc to close.
interface Props {
  images: string[];
  alt: string;
  featured?: boolean; // larger first tile, for the home page
}
const { images, alt, featured = false } = Astro.props;
---
<div class:list={['gallery', { featured }]} data-gallery>
  {images.map((src, i) => (
    <button type="button" class="tile" data-index={i} aria-label={`הגדלת תמונה ${i + 1} מתוך ${images.length}`}>
      <img src={`/images/${src}`} alt={alt} loading="lazy" />
      <span class="zoom" aria-hidden="true">⤢</span>
    </button>
  ))}
  <dialog class="viewer" aria-label="צפייה בתמונות">
    <img class="big" alt={alt} />
    <p class="count" aria-live="polite" dir="ltr"></p>
    <button type="button" class="nav close" aria-label="סגירה">✕</button>
    <button type="button" class="nav prev" aria-label="התמונה הקודמת">›</button>
    <button type="button" class="nav next" aria-label="התמונה הבאה">‹</button>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const tiles = [...root.querySelectorAll<HTMLButtonElement>('.tile')];
    const srcs = tiles.map((t) => t.querySelector('img')!.getAttribute('src')!);
    const dialog = root.querySelector('dialog') as HTMLDialogElement;
    const big = dialog.querySelector('.big') as HTMLImageElement;
    const count = dialog.querySelector('.count') as HTMLElement;
    let index = 0;

    const show = (i: number) => {
      index = (i + srcs.length) % srcs.length;
      big.src = srcs[index];
      count.textContent = `${index + 1} / ${srcs.length}`;
    };
    tiles.forEach((t, i) => t.addEventListener('click', () => { show(i); dialog.showModal(); }));
    dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());
    // In RTL, "next" points left.
    dialog.querySelector('.next')!.addEventListener('click', () => show(index + 1));
    dialog.querySelector('.prev')!.addEventListener('click', () => show(index - 1));
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index + 1);
      if (e.key === 'ArrowRight') show(index - 1);
    });
    let startX = 0;
    dialog.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) show(index + (dx < 0 ? 1 : -1));
    });
    dialog.addEventListener('close', () => tiles[index]?.focus());
  });
</script>

<style>
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
  .gallery.featured { grid-template-columns: repeat(4, 1fr); grid-auto-rows: 190px; }
  .gallery.featured .tile:first-child { grid-column: span 2; grid-row: span 2; }
  .gallery.featured .tile:nth-child(6) { grid-column: span 2; }
  .tile {
    position: relative; padding: 0; border: 0; border-radius: var(--radius); overflow: hidden;
    cursor: zoom-in; background: #dfe6ec; aspect-ratio: 4 / 3;
  }
  .featured .tile { aspect-ratio: auto; }
  .tile img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .tile::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(15, 42, 68, 0.6), transparent 55%);
    opacity: 0; transition: opacity 0.3s ease;
  }
  .zoom {
    position: absolute; bottom: 12px; left: 12px; z-index: 1; width: 38px; height: 38px;
    border-radius: 50%; background: var(--accent); color: #1a1300; display: grid; place-items: center;
    font-size: 1.1rem; opacity: 0; transform: scale(0.6); transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .tile:hover img, .tile:focus-visible img { transform: scale(1.08); }
  .tile:hover::after, .tile:focus-visible::after, .tile:hover .zoom, .tile:focus-visible .zoom { opacity: 1; }
  .tile:hover .zoom, .tile:focus-visible .zoom { transform: none; }

  .viewer {
    width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 0;
    border: 0; background: rgba(6, 18, 30, 0.94); color: #fff;
  }
  .viewer[open] { display: grid; place-items: center; }
  .viewer::backdrop { background: transparent; }
  .big { max-width: 92vw; max-height: 82vh; object-fit: contain; border-radius: 8px; }
  .count { position: absolute; bottom: 16px; margin: 0; font-weight: 500; }
  .nav {
    position: absolute; width: 52px; height: 52px; border-radius: 50%; border: 0;
    background: rgba(255, 255, 255, 0.12); color: #fff; font-size: 2rem; line-height: 1; cursor: pointer;
  }
  .nav:hover { background: var(--accent); color: #1a1300; }
  .close { top: 16px; left: 16px; font-size: 1.3rem; }
  .prev { right: 16px; top: 50%; transform: translateY(-50%); }
  .next { left: 16px; top: 50%; transform: translateY(-50%); }

  @media (max-width: 760px) {
    .gallery.featured { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 140px; }
    .gallery.featured .tile:nth-child(6) { grid-column: auto; }
    .nav.prev, .nav.next { top: auto; bottom: 8px; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tile img, .tile::after, .zoom { transition: none; }
  }
</style>
