---
// Endless, auto-scrolling strip of logos. Pauses on hover/focus and stops
// for visitors who asked their device to reduce motion.
interface Props {
  logos: { src: string; alt: string }[];
  label: string;
  speed?: number; // seconds per full loop
}
const { logos, label, speed = 45 } = Astro.props;
---
<div class="marquee" role="region" aria-label={label} style={`--speed:${speed}s`}>
  <div class="track">
    <ul class="group">
      {logos.map((l) => <li><img src={`/images/${l.src}`} alt={l.alt} loading="lazy" /></li>)}
    </ul>
    <ul class="group" aria-hidden="true">
      {logos.map((l) => <li><img src={`/images/${l.src}`} alt="" loading="lazy" /></li>)}
    </ul>
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    padding: 14px 0;
    direction: ltr;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .track { display: flex; width: max-content; animation: scroll var(--speed) linear infinite; }
  .marquee:hover .track, .marquee:focus-within .track { animation-play-state: paused; }
  .group { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0 14px; }
  .group li {
    flex: 0 0 auto; width: 160px; height: 96px; background: #fff; border-radius: 12px;
    display: flex; align-items: center; justify-content: center; padding: 10px; overflow: hidden;
    box-shadow: 0 2px 10px rgba(15, 42, 68, 0.06);
  }
  .group img { display: block; width: 100%; height: 100%; object-fit: contain; object-position: center; }
  @keyframes scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; }
    .group[aria-hidden] { display: none; }
    .group { flex-wrap: wrap; justify-content: center; }
  }
</style>
